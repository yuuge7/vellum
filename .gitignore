# Release signing: never commit these (see README, "Release signing")
key.properties
*.jks
*.keystore
*.p12
*.jks.base64

# Markdown: only the README is published
*.md
!README.md

# AI assistant local settings
.claude/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
Thumbs.db
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code: shared launch/task configs may be committed, personal settings not
.vscode/settings.json

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android build output and local paths (android/.gitignore covers the rest)
/android/app/debug
/android/app/profile
/android/app/release
/android/local.properties
*.apk
*.aab

# Widget Preview related
.widget_preview/
